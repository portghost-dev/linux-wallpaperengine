pkgname=linux-wallpaperengine-git
_pkgname=linux-wallpaperengine
pkgver=r567.b6c1825
pkgrel=1
pkgdesc="use steam's wallpaperengine on linux"
arch=('x86_64')
url="https://github.com/portghost-dev/linux-wallpaperengine"
license=('GPL-3.0-only')
depends=('lz4' 'ffmpeg' 'mpv' 'glfw' 'glew' 'glu' 'libpulse' 'dbus' 'freetype2' 'sdl2-compat'
         'libcups' 'at-spi2-core' 'nss' 'libxcomposite' 'libxdamage' 'nspr')
makedepends=('git' 'cmake' 'glm' 'wayland-protocols' 'xorg-xrandr' 'ispc')
provides=("linux-wallpaperengine")
source=("${pkgname}::git+https://github.com/portghost-dev/linux-wallpaperengine.git#branch=main")
sha512sums=('SKIP')

pkgver() {
    cd "$pkgname"
        ( set -o pipefail
          git describe --long 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
          printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
        )
}

build() {
    cmake -B build -S "$pkgname" \
        -DCMAKE_BUILD_TYPE='Release' \
        -DCMAKE_INSTALL_PREFIX="/opt/${_pkgname}" \
        -Wno-dev \
        -DCMAKE_CXX_FLAGS="-ffat-lto-objects -Wno-builtin-macro-redefined" \
        -DCMAKE_C_FLAGS="-Wno-builtin-macro-redefined"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build --component lwe
    # the install is flat and the binaries find their libraries next to themselves
    install -d -m755 "${pkgdir}/usr/bin"
    cat > "${pkgdir}/usr/bin/${_pkgname}" << EOF
#!/bin/bash
cd /opt/${_pkgname}; exec ./${_pkgname} "\$@"
EOF
    chmod +x ${pkgdir}/usr/bin/${_pkgname}
}
